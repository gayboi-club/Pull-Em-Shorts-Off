{
  "manifest_version": 2,
  "name": "Pull Em Shorts Off",
  "version": "1.0.2",
  "description": "Block YouTube Shorts infinite scrolling. Watch individual Shorts but prevent doom-scrolling. Optional Discord daily notifications.",
  "author": "Energyboy :3",
  "homepage_url": "https://github.com/TimurHromek/Pull-Em-Shorts-Off",
  "permissions": [
    "storage",
    "alarms",
    "*://*.youtube.com/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/shorts-blocker.js",
        "content/sidebar-hider.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Pull Em Shorts Off - Settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pullemshortsoff@hromek.timur.gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}